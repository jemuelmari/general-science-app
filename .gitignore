[FILE: .gitignore]
# ============================================================
# .gitignore — General Science App
# ============================================================

# Editor & OS files
.DS_Store
Thumbs.db
*.swp
*~

# Backup files created by sed -i.bak and similar tools
*.bak
*.tmp
*.old
*_backup.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Node (if added later)
node_modules/
package-lock.json

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Secrets & local config (do NOT commit)
# Add a `config.local.js` if you want per-machine config
config.local.js

# Local backups
*.zip
*.tar.gz
